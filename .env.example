# Credentials needed before the end-to-end POC run (ticket #8).
# Neither is required for tests, build, lint, or health checks.

# Google Cloud Vision service account key (JSON file path).
# Provisioning is a human step: enable the Vision API, create a service account,
# download the key. Never commit the key file.
GOOGLE_APPLICATION_CREDENTIALS=

# Build-time LLM corrector (OpenAI-compatible). Provider and model are undecided.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
