{
  "name": "law-dictionary-ocr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Digitizing Mansoor Mokhtari's printed English to Persian legal dictionary into a searchable, verifiable lookup.",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "health": "fallow dead-code --format json --quiet"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/node": "^25.2.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
